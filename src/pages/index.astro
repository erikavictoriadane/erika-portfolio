    <script>
      const meetingForm = document.getElementById('meeting-form') as HTMLFormElement | null;
      const gmailBtn = document.getElementById('btn-open-gmail') as HTMLButtonElement | null;
      const copyEmailBtn = document.getElementById('btn-copy-email') as HTMLButtonElement | null;
      const copyEmailText = document.getElementById('copy-email-text') as HTMLSpanElement | null;
      const TARGET_EMAIL = 'erikavictoriadane@gmail.com';

      function getMailDetails() {
        if (!meetingForm) return null;
        const firstName = ((meetingForm.elements.namedItem('firstName') as HTMLInputElement)?.value || '').trim();
        const lastName = ((meetingForm.elements.namedItem('lastName') as HTMLInputElement)?.value || '').trim();
        const topic = ((meetingForm.elements.namedItem('topic') as HTMLSelectElement)?.value || '').trim();
        const message = ((meetingForm.elements.namedItem('message') as HTMLTextAreaElement)?.value || '').trim();

        if (!firstName) {
          (meetingForm.elements.namedItem('firstName') as HTMLInputElement)?.reportValidity();
          return null;
        }
        if (!topic) {
          (meetingForm.elements.namedItem('topic') as HTMLSelectElement)?.reportValidity();
          return null;
        }

        const fullName = lastName ? `${firstName} ${lastName}` : firstName;
        const subject = `[Portfolio Inquiry] ${topic} — ${fullName}`;
        const body = `Hi Erika,\n\nName: ${fullName}\nInquiry Topic: ${topic}\n\n${message ? message : 'I would love to connect with you regarding ' + topic + '.'}\n\nBest,\n${fullName}`;

        return { subject, body };
      }

      if (meetingForm) {
        meetingForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const details = getMailDetails();
          if (!details) return;
          window.location.href = `mailto:${TARGET_EMAIL}?subject=${encodeURIComponent(details.subject)}&body=${encodeURIComponent(details.body)}`;
        });
      }

      if (gmailBtn) {
        gmailBtn.addEventListener('click', () => {
          const details = getMailDetails();
          if (!details) return;
          const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(TARGET_EMAIL)}&su=${encodeURIComponent(details.subject)}&body=${encodeURIComponent(details.body)}`;
          window.open(gmailUrl, '_blank', 'noopener,noreferrer');
        });
      }

      if (copyEmailBtn && copyEmailText) {
        copyEmailBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(TARGET_EMAIL);
            const originalText = copyEmailText.textContent;
            copyEmailText.textContent = 'Copied to clipboard!';
            setTimeout(() => {
              copyEmailText.textContent = originalText;
            }, 2000);
          } catch {
            // Fallback if clipboard permission fails
          }
        });
      }
    </script>
