---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WorkGallery from '../components/WorkGallery.svelte';
import MediumCarousel from '../components/MediumCarousel.svelte';
import { getMediumArticles } from '../data/medium';

// Query artifacts collection using Astro content layer
const rawArtifacts = await getCollection('artifacts');

const isDev = import.meta.env.DEV;

// Format and serialize artifact items to pass as clean props into the Svelte island
const artifacts = rawArtifacts
  .filter((item) => isDev || !item.data.hidden)
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    description: item.data.description,
    tags: item.data.tags,
    link: item.data.link ?? null,
    showLiveLink: item.data.showLiveLink ?? false,
    date: item.data.date ? (item.data.date instanceof Date ? item.data.date.toISOString() : String(item.data.date)) : null,
    showDate: item.data.showDate ?? false,
    order: item.data.order ?? item.data.priority ?? null,
    featured: item.data.featured ?? false,
    hidden: item.data.hidden ?? false,
    previewImage: item.data.previewImage ?? '',
    mediaType: item.data.mediaType ?? 'image',
    videoUrl: item.data.videoUrl ?? '',
    galleryImages: item.data.galleryImages ?? [],
    metrics: item.data.metrics ?? '',
    body: item.body ?? '',
  }))
  .sort((a, b) => {
    const orderA = a.order !== null && a.order !== undefined ? Number(a.order) : Infinity;
    const orderB = b.order !== null && b.order !== undefined ? Number(b.order) : Infinity;
    if (orderA !== orderB) {
      return orderA - orderB;
    }
    return a.title.localeCompare(b.title, undefined, { sensitivity: 'base' });
  });

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch Erika's Medium articles from live RSS feed with resilient fallback
const mediumArticles = await getMediumArticles('erikavictoriadane');
---

<Layout
  title="Erika Finnimore | Marketing Strategy · Creative Direction"
  description="I'm a marketing strategist who combines creative thinking, audience insights, and data to develop campaigns, content, and experiences that connect with people and drive results."
>
  <!-- Sticky Glassmorphic Header Navigation -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 border-b border-[#dddedc]/80 transition-all">
    <div class="max-w-6xl mx-auto px-6 h-18 flex items-center justify-between">
      <a href="#hero" class="flex items-center gap-3 group shrink-0">
        <span class="w-8 h-8 rounded-full bg-[#102f10] flex items-center justify-center text-white font-bold text-xs tracking-tight shadow-sm group-hover:bg-[#184418] transition-all shrink-0">
          ef
        </span>
        <div class="nav-brand-text flex flex-col">
          <span class="font-bold text-base tracking-tight text-[#102f10] group-hover:text-[#184418] transition-colors lowercase whitespace-nowrap">
            erika finnimore
          </span>
          <span class="hidden sm:block text-[10px] font-mono tracking-widest uppercase text-[#84827e] whitespace-nowrap">
            Marketing Strategy · Creative Direction
          </span>
        </div>
      </a>

      <nav aria-label="Main Navigation">
        <ul class="flex items-center gap-1 sm:gap-6 text-xs font-bold uppercase tracking-wider text-[#84827e]">
          <li>
            <a href="#hero" class="px-3 py-1.5 rounded-full hover:text-[#67645e] hover:bg-[#efeef1] transition-colors">
              Overview
            </a>
          </li>
          <li>
            <a href="#about" class="px-3 py-1.5 rounded-full hover:text-[#67645e] hover:bg-[#efeef1] transition-colors">
              About
            </a>
          </li>
          <li>
            <a href="#work" class="px-3 py-1.5 rounded-full hover:text-[#67645e] hover:bg-[#efeef1] transition-colors">
              Work
            </a>
          </li>
          <li>
            <a href="#writing" class="px-3 py-1.5 rounded-full hover:text-[#67645e] hover:bg-[#efeef1] transition-colors">
              Writing
            </a>
          </li>
          <li>
            <a href="#contact" class="px-4 py-1.5 rounded-full border border-[#84827e] text-[#67645e] hover:bg-[#67645e] hover:text-white transition-all shadow-sm">
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <!-- Section 1: Hero (#hero) -->
    <section id="hero" class="relative pt-16 pb-16 md:pt-24 md:pb-20 max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Column: Headline, Bio & CTAs -->
        <div class="lg:col-span-7 space-y-6 sm:space-y-7">

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-[#102f10] tracking-tight leading-[1.12]">
            hi, i'm erika.
            <span class="block mt-1 font-normal text-[#102f10]">i make <span class="italic">ideas</span> happen.</span>
          </h1>

          <p class="text-base sm:text-lg text-[#525252] leading-relaxed font-normal max-w-xl">
            I'm a marketing strategist who combines creative thinking, audience insights, and data to develop campaigns, content, and experiences that connect with people and drive results.
          </p>

          <!-- Jump CTAs -->
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="#work"
              class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full font-bold text-xs tracking-wider uppercase bg-[#102f10] text-white hover:bg-[#184418] shadow-sm transition-all cursor-pointer"
            >
              <span>View My Work</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a
              href="#about"
              class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full font-bold text-xs tracking-wider uppercase bg-white text-[#67645e] border border-[#84827e] hover:bg-[#efeef1] shadow-sm transition-all cursor-pointer"
            >
              <span>About Me</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Framed Editorial Hero Portrait -->
        <div class="lg:col-span-5">
          <div class="relative group mx-auto max-w-sm lg:max-w-none">
            <!-- Flush Rhode rounded card framing -->
            <div class="relative rounded-3xl overflow-hidden bg-[#efeef1] p-2.5 sm:p-3 border border-[#dddedc] shadow-sm">
              <div class="aspect-[3/4] w-full overflow-hidden rounded-2xl bg-white relative">
                <img
                  src={`${baseUrl}/images/portrait-hero-white-shirt.jpg`}
                  alt="Marketing Director portrait"
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: About Me (#about) -->
    <section id="about" class="py-20 bg-white border-t border-[#dddedc]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <!-- Left Column: Editorial Portrait Card -->
          <div class="lg:col-span-5">
            <div class="relative group">
              <!-- Flush Rhode rounded card framing -->
              <div class="relative rounded-3xl overflow-hidden bg-[#efeef1] p-2.5 sm:p-3 border border-[#dddedc] shadow-sm">
                <div class="aspect-[3/4] w-full overflow-hidden rounded-2xl bg-white relative">
                  <img
                    src={`${baseUrl}/images/portrait.jpg`}
                    alt="Marketing Director portrait"
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Narrative Biography & Philosophy -->
          <div class="lg:col-span-7 space-y-6">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#102f10] tracking-tight leading-tight">
              about me
            </h2>

            <div class="space-y-4 text-[#525252] text-sm sm:text-base leading-relaxed font-normal">
              <p>
                I'm a marketing strategist who loves figuring out how to make things work better. That could mean finding a new way to reach an audience, prototyping designs for A/B tests, or turning a complicated idea into something people can connect with emotionally.
              </p>
              <p>
                My experience spans brand strategy, integrated marketing, customer engagement, and growth. I've worked across industries and audiences, bringing together creative thinking, customer insights, and performance data to develop marketing that delivers measurable results.
              </p>
              <p>
                I'm especially interested in how technology and AI are changing what's possible in marketing. I enjoy experimenting with new tools, challenging cumbersome processes, and finding faster, smarter ways to bring ideas to life.
              </p>
              <p>
                What motivates me most is the opportunity to work with people, create something meaningful, and see the impact of my work.
              </p>
              <p>
                Outside of work, you'll usually find me dancing, discovering new music, exploring somewhere new, or hunting down a really good cup of coffee. More recently, I've added puppy mom to my résumé thanks to Moki, my Shih Tzu, who's keeping me on my toes.
              </p>
              <p>
                I'm endlessly curious about people, places, and experiences, and I believe the best ideas often come from the connections we make between them.
              </p>
            </div>

            <!-- Actions -->
            <div class="pt-2 flex flex-wrap items-center gap-4">
              <a
                href="#work"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold tracking-wider uppercase bg-[#102f10] text-white hover:bg-[#184418] shadow-sm transition-all cursor-pointer"
              >
                <span>View My Work</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a
                href="#contact"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold tracking-wider uppercase bg-white text-[#67645e] border border-[#84827e] hover:bg-[#efeef1] shadow-sm transition-all cursor-pointer"
              >
                <span>Get In Touch</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
      CORE DISCIPLINES (Commented out for future reference)
      =========================================================================
    <section id="disciplines" class="py-24 bg-stone-100/70 border-y border-stone-200">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-2xl mb-14 space-y-3">
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-stone-600">Core Disciplines</div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight">
            Comprehensive marketing orchestration from seed to scale.
          </h2>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
            Uniting creative storytelling with analytical rigor to drive sustainable commercial velocity.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-8 rounded-2xl bg-white border border-stone-200 shadow-sm space-y-3">
            <div class="font-mono text-xs font-semibold text-stone-600 uppercase tracking-widest">Pillar 01</div>
            <h3 class="font-serif text-xl font-bold text-stone-900">Go-To-Market (GTM) Strategy & Product Launches</h3>
            <p class="text-stone-600 text-sm leading-relaxed">
              Defining ideal customer profiles, pricing architectures, competitive battlecards, and synchronized 360° launch timelines coordinating PR, digital, and sales enablement.
            </p>
          </div>

          <div class="p-8 rounded-2xl bg-white border border-stone-200 shadow-sm space-y-3">
            <div class="font-mono text-xs font-semibold text-stone-600 uppercase tracking-widest">Pillar 02</div>
            <h3 class="font-serif text-xl font-bold text-stone-900">Multi-Channel Performance & Demand Generation</h3>
            <p class="text-stone-600 text-sm leading-relaxed">
              Managing full-funnel paid acquisition across Meta, LinkedIn, Google Search, and programmatic OOH, continuously testing messaging variants to optimize CAC and pipeline throughput.
            </p>
          </div>

          <div class="p-8 rounded-2xl bg-white border border-stone-200 shadow-sm space-y-3">
            <div class="font-mono text-xs font-semibold text-stone-600 uppercase tracking-widest">Pillar 03</div>
            <h3 class="font-serif text-xl font-bold text-stone-900">Brand Architecture & Thought Leadership</h3>
            <p class="text-stone-600 text-sm leading-relaxed">
              Crafting distinct brand positioning, executive thought leadership engines, industry benchmark publications, and award-winning corporate design identities.
            </p>
          </div>

          <div class="p-8 rounded-2xl bg-white border border-stone-200 shadow-sm space-y-3">
            <div class="font-mono text-xs font-semibold text-stone-600 uppercase tracking-widest">Pillar 04</div>
            <h3 class="font-serif text-xl font-bold text-stone-900">Lifecycle Marketing, Retention & Experiential</h3>
            <p class="text-stone-600 text-sm leading-relaxed">
              Constructing automated onboarding email sequences, customer advocacy initiatives, and high-impact flagship conferences that foster enduring community loyalty.
            </p>
          </div>
        </div>

        <div class="mt-12 p-8 rounded-2xl bg-white/70 border border-stone-200 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-1">
            <div class="font-mono text-xs font-bold text-stone-600">01 / NARRATIVE-FIRST</div>
            <div class="font-serif text-base font-bold text-stone-900">Emotional Resonance</div>
            <p class="text-xs text-stone-600 leading-relaxed">Differentiating products by connecting directly with buyer ambitions.</p>
          </div>
          <div class="space-y-1">
            <div class="font-mono text-xs font-bold text-stone-600">02 / INCREMENTAL</div>
            <div class="font-serif text-base font-bold text-stone-900">Empirical Attribution</div>
            <p class="text-xs text-stone-600 leading-relaxed">Continuous testing of marketing lift rather than reliance on vanity clicks.</p>
          </div>
          <div class="space-y-1">
            <div class="font-mono text-xs font-bold text-stone-600">03 / COHESIVE</div>
            <div class="font-serif text-base font-bold text-stone-900">Cross-Functional Flywheel</div>
            <p class="text-xs text-stone-600 leading-relaxed">Aligning sales, product roadmap, and brand storytelling into a single beat.</p>
          </div>
        </div>
      </div>
    </section>
    ========================================================================= -->

    <!-- Section 3: Work Gallery (#work) -->
    <section id="work" class="py-24 bg-white border-t border-[#dddedc]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-2xl mb-12 space-y-3">
          <h2 class="text-3xl sm:text-4xl font-bold text-[#102f10] tracking-tight">
            work samples
          </h2>
          <p class="text-[#525252] text-sm sm:text-base leading-relaxed font-normal">
            Explore the challenge, strategy, execution, and results behind each project.
          </p>
        </div>

        <!-- Svelte Island Lazy Hydrated with client:visible -->
        <WorkGallery client:visible artifacts={artifacts} />
      </div>
    </section>

    <!-- Section 3.5: Medium Articles Carousel (#writing) -->
    <section id="writing" class="py-20 sm:py-24 bg-white border-t border-[#dddedc]">
      <div class="max-w-7xl mx-auto px-6">
        <MediumCarousel client:visible articles={mediumArticles} />
      </div>
    </section>

    <!-- Section 4: Recent Adventures & Connect (#contact) -->
    <section id="contact" class="py-20 sm:py-24 bg-white border-t border-[#dddedc]">
      <div class="max-w-6xl mx-auto px-6 space-y-16 sm:space-y-20">
        <!-- Part A: Recent Adventures Gallery -->
        <div class="space-y-6">
          <div class="text-center space-y-1.5">
            <h2 class="text-3xl sm:text-4xl font-bold text-[#102f10] tracking-tight">
              recent adventures
            </h2>
          </div>

          <!-- 5-Image Curated Adventures Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4">
            <div class="group relative aspect-square rounded-2xl overflow-hidden bg-[#efeef1] border border-[#dddedc] shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-1">
              <img
                src={`${baseUrl}/images/adventures/adventure-1.jpg`}
                alt="Botanical garden illuminated neon path"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="group relative aspect-square rounded-2xl overflow-hidden bg-[#efeef1] border border-[#dddedc] shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-1">
              <img
                src={`${baseUrl}/images/adventures/adventure-2.jpg`}
                alt="Henna lace design in cafe"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="group relative aspect-square rounded-2xl overflow-hidden bg-[#efeef1] border border-[#dddedc] shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-1">
              <img
                src={`${baseUrl}/images/adventures/adventure-3.jpg`}
                alt="Playful puppy"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="group relative aspect-square rounded-2xl overflow-hidden bg-[#efeef1] border border-[#dddedc] shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-1">
              <img
                src={`${baseUrl}/images/adventures/adventure-4.jpg`}
                alt="Cozy bookstore coffee"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="group relative aspect-square rounded-2xl overflow-hidden bg-[#efeef1] border border-[#dddedc] shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-1 col-span-2 sm:col-span-1">
              <img
                src={`${baseUrl}/images/adventures/adventure-5.jpg`}
                alt="Artisan wood-fired mushroom pizza"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Part B: Meeting Request, Follow & Spotify Grid -->
        <div class="pt-10 border-t border-[#dddedc] grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 items-start">
          <!-- Column 1: Request a Meeting With Me -->
          <div class="md:col-span-5 space-y-5">
            <h3 class="text-2xl sm:text-3xl font-bold text-[#102f10] tracking-tight">
              request a meeting
            </h3>

            <form id="meeting-form" class="space-y-3">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <input
                    type="text"
                    name="firstName"
                    id="meeting-first-name"
                    required
                    placeholder="First Name *"
                    class="w-full px-4 py-3 rounded-xl bg-[#efeef1] border border-[#dddedc] text-[#525252] placeholder:text-[#84827e] text-sm focus:outline-none focus:ring-2 focus:ring-[#102f10] focus:bg-white transition-all shadow-sm"
                  />
                </div>
                <div>
                  <input
                    type="text"
                    name="lastName"
                    id="meeting-last-name"
                    placeholder="Last Name"
                    class="w-full px-4 py-3 rounded-xl bg-[#efeef1] border border-[#dddedc] text-[#525252] placeholder:text-[#84827e] text-sm focus:outline-none focus:ring-2 focus:ring-[#102f10] focus:bg-white transition-all shadow-sm"
                  />
                </div>
              </div>
              <div class="relative">
                <select
                  name="topic"
                  id="meeting-topic"
                  required
                  class="w-full px-4 py-3 pr-10 rounded-xl bg-[#efeef1] border border-[#dddedc] text-[#525252] text-sm focus:outline-none focus:ring-2 focus:ring-[#102f10] focus:bg-white transition-all shadow-sm appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Select Inquiry Topic *</option>
                  <option value="Brand Strategy & Advisory">Brand Strategy & Advisory</option>
                  <option value="Creative Direction & Campaigns">Creative Direction & Campaigns</option>
                  <option value="Full-Time Leadership Opportunities">Full-Time Leadership Opportunities</option>
                  <option value="Speaking, Panels & Workshops">Speaking, Panels & Workshops</option>
                  <option value="Coffee Chat & Networking">Coffee Chat & Networking</option>
                  <option value="Other Collaboration">Other Collaboration</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-[#84827e]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
              <div>
                <textarea
                  name="message"
                  id="meeting-message"
                  rows="3"
                  placeholder="Subject or project details (optional)"
                  class="w-full px-4 py-3 rounded-xl bg-[#efeef1] border border-[#dddedc] text-[#525252] placeholder:text-[#84827e] text-sm focus:outline-none focus:ring-2 focus:ring-[#102f10] focus:bg-white transition-all shadow-sm resize-none"
                ></textarea>
              </div>
              <div class="pt-1 flex flex-col sm:flex-row gap-2.5">
                <button
                  type="submit"
                  id="btn-open-mail"
                  class="flex-1 px-5 py-3 rounded-full font-bold text-xs tracking-wider uppercase bg-[#102f10] text-white hover:bg-[#184418] shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                  </svg>
                  <span>SEND VIA EMAIL APP</span>
                </button>
                <button
                  type="button"
                  id="btn-open-gmail"
                  class="flex-1 px-5 py-3 rounded-full font-bold text-xs tracking-wider uppercase bg-white border border-[#102f10] text-[#102f10] hover:bg-[#102f10] hover:text-white shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.272H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 9.248l8.073-5.755C21.69 2.28 24 3.434 24 5.457z"/>
                  </svg>
                  <span>OPEN IN GMAIL</span>
                </button>
              </div>
              <div class="pt-2 flex items-center justify-between text-xs text-[#84827e]">
                <span>Direct email:</span>
                <button
                  type="button"
                  id="btn-copy-email"
                  class="inline-flex items-center gap-1.5 font-mono text-[#102f10] hover:text-[#184418] hover:underline cursor-pointer"
                  title="Click to copy email address"
                >
                  <span id="copy-email-text">erikavictoriadane@gmail.com</span>
                  <svg class="w-3.5 h-3.5 text-[#84827e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </div>
            </form>
          </div>

          <!-- Column 2: Follow Me & Quick Links -->
