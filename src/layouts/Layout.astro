---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Portfolio | Marketing Director & Brand Strategist",
  description = "Marketing Manager & Brand Strategist portfolio showcasing integrated GTM campaigns, quantitative growth frameworks, and high-impact brand repositioning."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-white text-stone-800 antialiased selection:bg-[#efeef1] selection:text-[#67645e]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg?v=2`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      .font-handwriting {
        font-family: 'Caveat', cursive;
      }
      code, pre, .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-white overflow-x-hidden text-stone-800 selection:bg-[#efeef1] selection:text-[#67645e]">
    <slot />
  </body>
</html>
